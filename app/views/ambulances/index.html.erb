<h1>Ambulances</h1>

<ul>
  <% @ambulance.each do |ambulance| %>
    <li>
      <a href="<%= ambulance_path(ambulance) %>">
        <%= ambulance.name %>
      </a>
    </li>
  <% end %>

  <li><%= link_to "All Ambulances", ambulances_path %></li>
 
</ul>

 <button>
    <%= link_to "Create an Ambulance", new_ambulance_path%>
  </button>