<%= stylesheet_link_tag "hospital" %>

<h1>Hospitals</h1>

<ul>
  <% @hospital.each do |hospital| %>
    <li>
      <a href="<%= hospital_path(hospital) %>">
        <%= hospital.name %>
      </a>
    </li>
  <% end %>
</ul>

<button>
  <%= link_to "Create a hospital", new_hospital_path %>
</button>