<!DOCTYPE html>
<html>
  <head>
    <title>GpsAmbulanceNotification</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="container">
    <aside class="sidebar">
      <%= render 'layouts/sidebar' %>
    </aside>
    <main class="content">
      <%= yield %>
    </main>
  </div>

  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    .container {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 250px;
      background-color: #2c3e50; /* Dark background for the sidebar */
      color: #ecf0f1; /* Light text color */
      padding: 20px;
      box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1); /* Shadow to create separation */
      position: fixed; /* Keep sidebar fixed while scrolling */
      top: 0;
      left: 0;
      height: 100%;
      z-index: 1000; /* Ensure the sidebar stays on top */
    }

    .content {
      margin-left: 250px; /* Ensure content starts to the right of the sidebar */
      padding: 20px;
      padding-left: 50px;
      background-color: #f8f9fa; /* Light background for contrast */
      flex: 1; /* Take up remaining space */
      overflow: auto; /* Ensure content scrolls if it overflows the view */
    }

    .sidebar ul {
      list-style-type: none;
      padding: 0;
    }

    .sidebar ul li {
      margin-bottom: 15px;
    }

    .sidebar ul li a {
      color: #ecf0f1;
      text-decoration: none;
    }

    .sidebar ul li a:hover {
      text-decoration: underline;
    }
  </style>
</body>
</html>
